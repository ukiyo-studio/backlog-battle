# Supabase — client-safe (required for Phase 1)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Expo push tokens (required for native reminders in Phase 4)
EXPO_PUBLIC_EAS_PROJECT_ID=
# Sentry (client DSN). Set the same name as an EAS environment variable. Do not commit the value.
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only, for source map and debug symbol upload. Set as an EAS secret. Never commit.
# SENTRY_AUTH_TOKEN=
# Server-only secrets for Edge Functions / cron — never put these in the Expo app env
# SUPABASE_SERVICE_ROLE_KEY=
# EXPO_ACCESS_TOKEN=          # optional Expo push auth for process-reminders
# CRON_SECRET=                # required by process-reminders (Authorization: Bearer …)