{
  "expo": {
    "name": "Backlog Battle",
    "slug": "backlog-battle",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "backlogbattle",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ukiyo.backlogbattle",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Backlog Battle sends reminders when it's time to run a new battle and refresh your backlog ranking."
      }
    },
    "android": {
      "package": "com.ukiyo.backlogbattle",
      "adaptiveIcon": {
        "backgroundColor": "#FAF5EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF5EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2563EB",
          "defaultChannel": "reminders",
          "sounds": []
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "ukiyo-floating-world",
          "project": "backlog-battle"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31b46378-b2a6-4308-9064-b2c20ca76f50"
      }
    },
    "owner": "ukiyo.development"
  }
}
